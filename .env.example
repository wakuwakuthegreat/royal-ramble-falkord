# ---- LLM (provider switch: groq | openrouter | openai-compatible) ----
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=
# OPENROUTER_API_KEY=   # also the automatic fallback when the main provider fails (same model via OpenRouter)
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPATIBLE_API_KEY=ollama

# ---- FalkorDB: the memory graph (docker compose up falkordb, or a FalkorDB Cloud URL) ----
FALKORDB_URL=falkor://localhost:6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=

# PORT=8787

# ---- Off-site copy of shared worlds (only for free hosts whose disk is wiped; free at upstash.com) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# STORE_PREFIX=rr-local:   # set locally if dev and the live server share one Redis
